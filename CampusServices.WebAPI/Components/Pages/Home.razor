@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using CampusServices.Application.DTOs
@using CampusServices.Domain.Enums
@inject HttpClient Http

<PageTitle>Campus Services Portal</PageTitle>

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Campus Services Portal</h3>
            <small class="text-muted">Blazor Razor UI + REST API</small>
        </div>
        <button class="btn btn-outline-primary btn-sm" @onclick="LoadRequests">Refresh</button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info py-2">@message</div>
    }

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <small class="text-muted">Total Requests</small>
                <h4 class="fw-bold mb-0">@requests.Count</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <small class="text-warning">Pending</small>
                <h4 class="fw-bold mb-0">@requests.Count(r => r.Status == "Pending")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <small class="text-info">In Progress</small>
                <h4 class="fw-bold mb-0">@requests.Count(r => r.Status == "InProgress")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <small class="text-success">Completed</small>
                <h4 class="fw-bold mb-0">@requests.Count(r => r.Status == "Completed")</h4>
            </div>
        </div>
    </div>

    <!-- Create / Edit Ticket Form -->
    <div class="card p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3">@(isEditing ? "Edit Service Request" : "Submit New Request")</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Title</label>
                <input class="form-control" @bind="title" placeholder="Issue title..." />
            </div>
            <div class="col-md-4">
                <label class="form-label">Category</label>
                <select class="form-select" @bind="category">
                    <option value="0">IT Support</option>
                    <option value="1">Hostel Maintenance</option>
                    <option value="2">Electrical Repair</option>
                    <option value="3">Sanitation</option>
                </select>
            </div>
            @if (isEditing)
            {
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="status">
                        <option value="0">Pending</option>
                        <option value="1">In Progress</option>
                        <option value="2">Completed</option>
                    </select>
                </div>
            }
            <div class="col-md-8">
                <label class="form-label">Description</label>
                <input class="form-control" @bind="description" placeholder="Describe the issue..." />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                @if (isEditing)
                {
                    <button class="btn btn-success w-100" @onclick="UpdateRequest">Save Changes</button>
                    <button class="btn btn-secondary" @onclick="ResetForm">Cancel</button>
                }
                else
                {
                    <button class="btn btn-primary w-100" @onclick="CreateRequest">Submit Ticket</button>
                }
            </div>
        </div>
    </div>

    <!-- Tickets Table -->
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in requests)
                {
                    <tr>
                        <td class="fw-semibold">@item.Title</td>
                        <td>@item.Category</td>
                        <td>@item.Description</td>
                        <td>
                            <select class="form-select form-select-sm" style="width:140px;"
                                    value="@StatusToInt(item.Status)"
                                    @onchange="@(e => ChangeStatus(item.Id, int.Parse(e.Value!.ToString()!)))">
                                <option value="0">Pending</option>
                                <option value="1">In Progress</option>
                                <option value="2">Completed</option>
                            </select>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(item)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRequest(item.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<RequestResponseDto> requests = new();
    private string? message;
    private bool isEditing = false;
    private Guid editId;

    private string title = "";
    private int category = 0;
    private int status = 0;
    private string description = "";

    protected override async Task OnInitializedAsync() => await LoadRequests();

    private async Task LoadRequests()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<RequestResponseDto>>("api/ServiceRequests");
            if (result != null) requests = result;
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }

    private async Task CreateRequest()
    {
        if (string.IsNullOrWhiteSpace(title)) return;

        var dto = new CreateRequestDto(title, description, (RequestCategory)category);

        var res = await Http.PostAsJsonAsync("api/ServiceRequests", dto);
        if (res.IsSuccessStatusCode)
        {
            message = "Request submitted!";
            ResetForm();
            await LoadRequests();
        }
    }

    private void StartEdit(RequestResponseDto item)
    {
        isEditing = true;
        editId = item.Id;
        title = item.Title;
        description = item.Description;
        category = item.Category switch
        {
            "HostelMaintenance" => 1,
            "ElectricalRepair" => 2,
            "Sanitation" => 3,
            _ => 0
        };
        status = StatusToInt(item.Status);
    }

    private async Task UpdateRequest()
    {
        var dto = new CreateRequestDto(title, description, (RequestCategory)category);

        await Http.PutAsJsonAsync($"api/ServiceRequests/{editId}", dto);
        await Http.PutAsJsonAsync($"api/ServiceRequests/{editId}/status", new UpdateStatusDto((CampusServices.Domain.Enums.RequestStatus)status, null));

        message = "Request updated!";
        ResetForm();
        await LoadRequests();
    }

    private async Task ChangeStatus(Guid id, int newStatus)
    {
        await Http.PutAsJsonAsync($"api/ServiceRequests/{id}/status", new UpdateStatusDto((CampusServices.Domain.Enums.RequestStatus)newStatus, null));
        message = "Status updated!";
        await LoadRequests();
    }

    private async Task DeleteRequest(Guid id)
    {
        await Http.DeleteAsync($"api/ServiceRequests/{id}");
        message = "Request deleted!";
        await LoadRequests();
    }

    private void ResetForm()
    {
        isEditing = false;
        title = "";
        description = "";
        category = 0;
        status = 0;
    }

    private int StatusToInt(string s) => s switch
    {
        "InProgress" => 1,
        "Completed" => 2,
        _ => 0
    };
}